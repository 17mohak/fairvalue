# Copy to .env.local for `npm run dev`. Never commit .env.local.
# Where the FairValue FastAPI service runs. Read on the server only (the browser never sees it):
# the web app proxies /api/predict, /api/explain and /api/health to this URL.
FAIRVALUE_API_URL=http://127.0.0.1:8000
# Public base URL of the site, for canonical links and share-image URLs (server only).
# Leave unset locally (defaults to http://localhost:3000). REQUIRED for any public deployment, and
# needed at build time as well as run time (see docs/DEPLOYMENT.md). A malformed value fails the build.
# FAIRVALUE_SITE_URL=https://fairvalue.example
